{
  "name": "@loyalty/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./admin": {
      "types": "./src/admin.ts",
      "default": "./src/admin.ts"
    },
    "./marketing": {
      "types": "./src/marketing.ts",
      "default": "./src/marketing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env --experimental-strip-types src/migrate.ts"
  },
  "dependencies": {
    "@loyalty/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
