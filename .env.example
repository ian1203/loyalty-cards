# Rol admin/migrador (owner de las tablas, bypassa RLS). Solo para migraciones,
# seed y setup de tests — nunca para servir requests de la aplicación.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/loyalty_dev

# Rol de aplicación (sin BYPASSRLS). Toda query que atienda una request real
# debe pasar por este rol, dentro de withTenantContext().
APP_DATABASE_URL=postgres://app_user:app_user@localhost:5432/loyalty_dev

# Misma pareja de variables, apuntando a la base usada por los tests de
# integración (packages/db/tests).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/loyalty_test
TEST_APP_DATABASE_URL=postgres://app_user:app_user@localhost:5432/loyalty_test
